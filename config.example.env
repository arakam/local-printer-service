# Configurações do Local Printer Service
# Copie este arquivo para .env e ajuste conforme necessário

# Porta do servidor HTTP (padrão: 9100)
PORT=9100

# Nome da impressora Windows (deve ser exato)
# Para listar impressoras: Get-Printer no PowerShell
# NOME_IMPRESSORA=ZDesigner ZD420-203dpi ZPL
NOME_IMPRESSORA=Microsoft Print to PDF

# Modo de simulação (true/false)
# true = salva ZPL em arquivo (para testes)
# false = envia para impressora real
SIMULACAO=true
